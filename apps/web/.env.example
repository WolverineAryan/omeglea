# =================================================================
# OMEGLEA WEB FRONTEND PRODUCTION ENVIRONMENT CONFIGURATION
# =================================================================

# Backend Public API URL (Render / Custom Domain)
NEXT_PUBLIC_API_URL=https://your-backend-service.onrender.com

# Backend Public Socket.IO WebSocket URL
NEXT_PUBLIC_SOCKET_URL=https://your-backend-service.onrender.com

# Optional Stripe Publishable Key (for client-side Stripe checkout)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...

# Optional Razorpay Key ID (for client-side Razorpay modal)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_...
