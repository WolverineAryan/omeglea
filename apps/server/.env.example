# =================================================================
# OMEGLEA BACKEND PRODUCTION ENVIRONMENT CONFIGURATION
# =================================================================

# Server Port & Mode
PORT=4000
NODE_ENV=production
CLIENT_URL=https://omeglea.vercel.app

# Reverse Proxy / Load Balancer Settings
TRUST_PROXY=true

# MongoDB Atlas (Production Cluster Connection URI)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/omeglea?retryWrites=true&w=majority

# Authentication Secrets (Generate secure 64-character random strings)
JWT_SECRET=production-jwt-secret-replace-with-high-entropy-64-character-string
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_SECRET=production-refresh-secret-replace-with-high-entropy-64-character-string

# Email Service (SMTP)
EMAIL_FROM=noreply@omeglea.com
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_USER=apikey
EMAIL_PASS=your-sendgrid-api-key

# WebRTC STUN / TURN Servers
STUN_SERVER=stun:stun.l.google.com:19302
TURN_SERVER=turn:your-turn-server.com:3478
TURN_USERNAME=omeglea_turn_user
TURN_CREDENTIAL=omeglea_turn_secret

# Payment Gateways (Set PAYMENT_MODE=live for real payments, or mock for simulated testing)
PAYMENT_MODE=live

# Stripe Integration
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Razorpay Integration
RAZORPAY_KEY_ID=rzp_live_...
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Optional Redis for Horizontal Multi-Instance Load Balancing & Socket Cluster Scaling
REDIS_URL=redis://default:<password>@<redis-host>:6379

# Cloudinary Media Storage (For Avatars & Snapshots)
CLOUDINARY_CLOUD_NAME=drhbgm91r
CLOUDINARY_API_KEY=516629949987979
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
